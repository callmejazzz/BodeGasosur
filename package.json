{
  "name": "bodegasosur",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run db:configuracion && npm run datos:migrar && npm run db:fixtures && npm run acceso:arranque",
    "db:configuracion": "tsx prisma/configuracion.ts",
    "db:fixtures": "tsx prisma/fixtures.ts",
    "datos:migrar": "tsx prisma/migracion-datos/migrar.ts",
    "acceso:arranque": "tsx scripts/arranque-superadmin.ts",
    "prod:bootstrap": "tsx scripts/bootstrap-produccion.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.13",
    "@clerk/localizations": "^4.15.8",
    "@clerk/nextjs": "^7.8.3",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "description": "Sistema de control de inventario para las bodegas del grupo Gasosur",
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
