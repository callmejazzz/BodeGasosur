# Entorno local aislado. Cada desarrollador elige un nombre y un puerto propios;
# no copies el .env de otra persona. Docker Compose usa COMPOSE_PROJECT_NAME para
# separar contenedores y volúmenes aun si hay varios clones en la misma máquina.
COMPOSE_PROJECT_NAME="bodegasosur_tu_nombre"
POSTGRES_PORT="5434"
POSTGRES_DB="bodegasosur_tu_nombre"
POSTGRES_USER="bodegasosur"
POSTGRES_PASSWORD="bodegasosur"

# PostgreSQL local vía docker compose. Debe coincidir con POSTGRES_PORT y POSTGRES_DB.
# Dos usuarios sobre la misma base: las migraciones y los scripts de datos corren como
# el dueño del esquema (el de docker compose); la aplicación, como un usuario sin
# propiedad que `npm run db:usuario-app` crea con esta contraseña. Elige una propia.
# La aplicación solo escribe con un token de Clerk que la base verifica: después de
# migrar, carga las llaves públicas con `npm run db:llaves-clerk` (db:reset lo hace).
DATABASE_URL_MIGRACIONES="postgresql://bodegasosur:bodegasosur@localhost:5434/bodegasosur_tu_nombre?schema=public"
DATABASE_URL="postgresql://bodegasosur_app:cambia-esta-contrasena@localhost:5434/bodegasosur_tu_nombre?schema=public"

# Base de las pruebas (`npm run test`). Se DESTRUYE y se recrea en cada corrida, por eso
# tiene que llamarse *_prueba: el arranque de las pruebas se niega a usar otro nombre.
# Es la URL del dueño; el usuario de ejecución de las pruebas se crea en cada corrida.
DATABASE_URL_PRUEBAS="postgresql://bodegasosur:bodegasosur@localhost:5434/bodegasosur_tu_nombre_prueba?schema=public"

# Autoriza los fixtures de desarrollo (`npm run db:fixtures`, encadenado en `db:reset`).
# Descomentar SOLO en una máquina de desarrollo: sin esta variable los fixtures se niegan
# a correr, y con ella definida el bootstrap de producción se niega a correr.
BODEGASOSUR_FIXTURES="permitidos"

# Clerk — autenticación. Las llaves se obtienen del panel (dashboard.clerk.com) o con
# `clerk env pull`; nunca se versionan. La secreta jamás se usa en código de cliente.
# Requiere la plantilla JWT «bodegasosur-db»: en blanco, sin llave de firma propia
# (RS256 de la instancia), vida de 30 s y solo { "aud": "bodegasosur-db" } en Claims.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Rutas de las pantallas de acceso. A dónde cae la sesión recién iniciada.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Correo del primer Superadmin. `npm run acceso:arranque` resuelve con él su
# identificador en Clerk y crea la fila de Usuario que le da acceso. Se corre
# una vez por entorno; `db:reset` y `prod:bootstrap` lo encadenan al final.
CLERK_SUPERADMIN_CORREO="alguien@ejemplo.com"

# Firma de los webhooks de Clerk. Sale del endpoint configurado en el panel, o
# del que crea `clerk webhooks listen` para desarrollo. Sin él, /api/webhooks/clerk
# responde 400 a todo.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
