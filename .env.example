# PostgreSQL local vía docker compose (puerto 5433 para no chocar con la instalación
# local de PostgreSQL 18 que ocupa el 5432).
DATABASE_URL="postgresql://bodegasosur:bodegasosur@localhost:5433/bodegasosur?schema=public"

# Base de las pruebas (`npm run test`). Se DESTRUYE y se recrea en cada corrida, por eso
# tiene que llamarse *_prueba: el arranque de las pruebas se niega a usar otro nombre.
DATABASE_URL_PRUEBAS="postgresql://bodegasosur:bodegasosur@localhost:5433/bodegasosur_prueba?schema=public"

# Autoriza los fixtures de desarrollo (`npm run db:fixtures`, encadenado en `db:reset`).
# Descomentar SOLO en una máquina de desarrollo: sin esta variable los fixtures se niegan
# a correr, y con ella definida el bootstrap de producción se niega a correr.
BODEGASOSUR_FIXTURES="permitidos"

# Clerk — autenticación. Las llaves se obtienen del panel (dashboard.clerk.com) o con
# `clerk env pull`; nunca se versionan. La secreta jamás se usa en código de cliente.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Rutas de las pantallas de acceso. A dónde cae la sesión recién iniciada.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Correo del primer Superadmin. `npm run acceso:arranque` resuelve con él su
# identificador en Clerk y crea la fila de Usuario que le da acceso. Se corre
# una vez por entorno; `db:reset` y `prod:bootstrap` lo encadenan al final.
CLERK_SUPERADMIN_CORREO="alguien@ejemplo.com"

# Firma de los webhooks de Clerk. Sale del endpoint configurado en el panel, o
# del que crea `clerk webhooks listen` para desarrollo. Sin él, /api/webhooks/clerk
# responde 400 a todo.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
